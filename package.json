{
  "name": "@honeypotfeed/honeypot-feed-widget",
  "version": "1.0.0",
  "description": "Embeddable widget for token honeypot detection. Scan any token across 15+ networks for scams, rugpulls, and honeypots.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "honeypot",
    "token",
    "security",
    "widget",
    "web3",
    "crypto",
    "scam-detection",
    "erc20",
    "solana",
    "evm"
  ],
  "author": "Honeypot Feed",
  "license": "MIT",
  "homepage": "https://honeypotfeed.info",
  "repository": {
    "type": "git",
    "url": "https://github.com/honeypotfeed/honeypot-feed-widgets.git"
  },
  "bugs": {
    "url": "https://github.com/honeypotfeed/honeypot-feed-widgets/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "sideEffects": false
}
