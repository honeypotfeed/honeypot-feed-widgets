{
  "name": "@honeypot-feed/react",
  "version": "1.0.2",
  "description": "React wrapper for Honeypot Feed Widget - token honeypot detection for React apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "honeypot",
    "token",
    "security",
    "widget",
    "web3",
    "crypto",
    "scam-detection",
    "react",
    "component",
    "erc20",
    "solana",
    "evm"
  ],
  "author": "Honeypot Feed",
  "license": "MIT",
  "homepage": "https://honeypotfeed.info",
  "repository": {
    "type": "git",
    "url": "https://github.com/JudahAragao/honeypot-feed-widget.git"
  },
  "bugs": {
    "url": "https://github.com/JudahAragao/honeypot-feed-widget/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "honeypot-feed-widget": "file:.."
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "sideEffects": false
}
